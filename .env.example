# Copy this file to .env and fill it in. .env holds secrets: git ignores it
# and it is never copied into the Docker image.
# "__" means one level down in the settings: Tv__Ip is the setting Tv:Ip.

# The TV
Tv__Ip=192.168.1.50
Tv__AuthToken=

# The page the TV opens (the tvshim proxy). Use the LAN address of the PC running Docker.
Tv__AppUrl=http://192.168.1.10:8097/web/index.html

# Jellyfin. host.docker.internal means "the PC running Docker", seen from inside a container.
Jellyfin__BaseUrl=http://host.docker.internal:8096
Jellyfin__ApiKey=

# Optional: if set, callers must send this in the X-Api-Key header.
Api__Key=
